# Python bytecode cache, regenerated on import.
__pycache__/
*.pyc

# Ruff lint cache, regenerated on lint.
.ruff_cache/

# Native build output, regenerated by build_julia.jl / rebuild_native.sh / cargo build.
plugin/build/
plugin/rust/target/

# Crash core dumps, should never be committed if one appears.
core.[0-9]*

# SLURM job stdout, regenerated by every sbatch submission.
logs/

# Serialized circuit inputs, regenerated by orchestrate.py and trotter/run_trotter_scan.py on every run.
results/raw/

# Scratch space for one-off debug scripts, not part of the reproducible pipeline.
.scratch/
