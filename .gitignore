# Python bytecode cache, regenerated on import.
__pycache__/
*.pyc

# Ruff lint cache, regenerated on lint.
.ruff_cache/

# Native build output, regenerated by build_julia.jl / rebuild_native.sh / cargo build.
plugin/build/
plugin/rust/target/

# Crash core dumps, should never be committed if one appears.
core.[0-9]*

# SLURM job stdout, regenerated by every sbatch submission.
logs/

# Scratch space for one-off debug scripts, not part of the reproducible pipeline.
.scratch/

# Result data from the old orchestrator-driven architecture (see git history), superseded
# by each experiments/<name>/results_<backend>.{jsonl,npz}. Kept on disk as historical
# reference, not tracked.
results/main_suite.jsonl
results/main_suite.npz
results/scaling_suite.jsonl
results/scaling_suite.npz
results/trotter_scan.jsonl
results/trotter_scan.npz
results/trotter_scan_precheck.jsonl
results/trotter_scan_precheck.npz
results/trotter_sparse_ab.jsonl
results/trotter_sparse_ab.npz
results/propaq_vs_pyrauli.jsonl
results/propaq_vs_pyrauli.npz
results/smoke_0.1.3.jsonl
results/smoke_0.1.3.npz
results/custom_decomposition.jsonl
results/custom_decomposition.npz
results/hybrid_mps_heisenberg.jsonl
results/hybrid_mps_heisenberg.npz
results/hybrid_ucj_heisenberg.jsonl
results/hybrid_ucj_heisenberg.npz
results/surrogate_optimization.jsonl
results/surrogate_optimization.npz
results/thread_scaling.jsonl
results/thread_scaling.npz
results/clifford_deferral_ablation.jsonl
results/clifford_deferral_ablation.npz
